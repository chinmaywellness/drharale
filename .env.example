# ================= Chinmay Wellness Club — Environment Variables =================
# Copy this file to .env (local) or set these in your host's dashboard (Hostinger / Vercel).
# NEVER commit real values. Only NEXT_PUBLIC_* vars are exposed to the browser.

# --- Public (safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=919975727098
NEXT_PUBLIC_SITE_NAME=Chinmay Wellness Club
NEXT_PUBLIC_SITE_URL=https://chinmaywellnessclub.in

# --- Server-side secrets (NEVER expose to client / never commit) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM=Chinmay Wellness Club <no-reply@chinmaywellnessclub.in>
ADMIN_EMAIL=samfonde0@gmail.com
ADMIN_EMAILS=samfonde0@gmail.com

